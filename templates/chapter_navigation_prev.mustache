{{#viewgiportfolio}}
    <form action= "{{url}}" method = "post" class='chapter-navigation'>
    <input type="hidden" name="id" value ="{{cmid}}">
    <input type="hidden" name="chapterid" value ="{{chapterid}}">
    <input type="hidden" name="mentor" value ="{{mentor}}">
    <input type="hidden" name="mentee" value ="{{mentee}}">
    <input type="hidden" name="contribute" value ="{{contribute}}">
        {{^inactive}}
            <button type="submit" class="bigicon" title ="Prev">
                <i class="fa fa-arrow-circle-o-left" aria-hidden="true"></i>
            </button>
        {{/inactive}}
        {{#inactive}}
        
            <button type="submit" class="bigicon inactive">
                <i class="fa fa-arrow-circle-o-left" aria-hidden="true"></i>
            </button>
        {{/inactive}}
    </form>
{{/viewgiportfolio}}

{{#viewcontribute}}
  <form action= "{{url}}" method = "GET" class='chapter-navigation'>
    <input type="hidden" name="id" value ="{{cmid}}">
    <input type="hidden" name="chapterid" value ="{{chapterid}}">
    {{#mentor}}
        <input type="hidden" name="mentor" value ="{{mentor}}">
    {{/mentor}}
    <input type="hidden" name="userid" value ="{{userid}}">
        {{^inactive}}
            <button type="submit" class="bigicon" title ="Prev">
                <i class="fa fa-arrow-circle-o-left" aria-hidden="true"></i>
            </button>
        {{/inactive}}
        {{#inactive}}
        
            <button type="submit" class="bigicon inactive">
                <i class="fa fa-arrow-circle-o-left" aria-hidden="true"></i>
            </button>
        {{/inactive}}
    </form>
{{/viewcontribute}}