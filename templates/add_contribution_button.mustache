<form class="add-contrib {{#locked}}add-contrib-lock{{/locked}}" action= "{{url}}" method = "post" class='chapter-navigation'>
    <input type="hidden" name="id" value ="{{id}}">
    <input type="hidden" name="chapterid" value ="{{chapterid}}">
    <input type="hidden" name="mentor" value ="{{mentor}}">
    <input type="hidden" name="mentee" value ="{{mentee}}">
    <input type="hidden" name="contribute" value ="{{contribute}}">

    <button type="submit" class="bigicon" title = "{{#str}} addcontrib, mod_giportfolio {{/str}}">
        <i class="fa fa-plus-circle add-contribution" ></i>
    </button>
</form>
<br><br>