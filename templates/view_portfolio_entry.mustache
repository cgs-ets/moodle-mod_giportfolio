{{#playbutton}}
    {{> mod_giportfolio/start_contribute_play_button}}
    {{^skipintro}}
        {{{intro}}}
    {{/skipintro}}

    <br>
    {{#teacher}}
        {{^teacherandmentor}}
            {{chapternumbers}}
            <br>
            {{{submittedportfolios}}}
        {{/teacherandmentor}}
    {{/teacher}}

    {{#student}}
          {{^admin}}
            {{lastupdated}} <br>
            {{chapternumbers}} <br> <br>
            {{usergraded}} <br>
            {{finalfeedback}}
          {{/admin}}

    {{/student}}
{{/playbutton}}


{{#playparentbutton}}
    {{^skipintro}}
        {{{intro}}}
    {{/skipintro}}
    {{> mod_giportfolio/view_contribute_parent_access}}
{{/playparentbutton}}

{{#noneditingteacher}}
  {{^skipintro}}
        {{{intro}}}
    {{/skipintro}}
    {{#noneditingteachercancontribute}}
          {{{submittedportfolios}}}
    {{/noneditingteachercancontribute}}
{{/noneditingteacher}}

