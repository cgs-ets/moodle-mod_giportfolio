{{!
    @template mod_giportfolio/contributionsfilter

    Filter UI for the contribution report: year selector and optional groups filter.

    Example context (json):
    {
        "tableregionid": "giportfolio-contributions-2",
        "courseid": 2,
        "cmid": 45,
        "giportfolioid": 12,
        "selectedyear": 2026,
        "years": [
            {"value": 2026, "title": "2026", "selected": true},
            {"value": 2025, "title": "2025", "selected": false}
        ],
        "filtertypes": []
    }
}}
<div class="mb-3 d-flex align-items-center gap-2">
    <label for="contrib-year-{{uniqid}}" class="mb-0 fw-semibold">
        {{#str}}year, mod_giportfolio{{/str}}
    </label>
    <select id="contrib-year-{{uniqid}}"
            class="form-select w-auto"
            data-region="contributions-year-selector">
        {{#years}}
        <option value="{{value}}"{{#selected}} selected{{/selected}}>{{title}}</option>
        {{/years}}
    </select>
</div>

<form method="dialog">
    <div id="core-filter-contributions-{{uniqid}}"
         class="filter-group my-2 p-2 bg-light border-radius border"
         data-table-region="{{tableregionid}}"
         data-table-course-id="{{courseid}}"
         data-table-cmid="{{cmid}}"
         data-table-giportfolioid="{{giportfolioid}}"
         data-table-year="{{selectedyear}}"
         data-filterverb="2">
        {{> core/datafilter/filter_match }}

        <div data-filterregion="filters">
            {{> core/datafilter/filter_row }}
        </div>

        <div class="d-flex" data-filterregion="actions">
            &nbsp;
            <button type="button" class="btn btn-link text-reset" data-filteraction="add">
                {{#pix}}t/add{{/pix}}<span class="ps-3">{{#str}}addcondition{{/str}}</span>
            </button>
            <button data-filteraction="reset" type="button" class="btn btn-secondary ms-auto me-2">
                {{#str}}clearfilters{{/str}}
            </button>
            <button data-filteraction="apply" type="submit" class="btn btn-primary">
                {{#str}}applyfilters{{/str}}
            </button>
        </div>

        {{> core/datafilter/filter_types }}
    </div>
</form>

{{#js}}
    require(['mod_giportfolio/contributions_filter'], function(ContributionsFilter) {
        ContributionsFilter.init('core-filter-contributions-{{uniqid}}');
    });
{{/js}}
