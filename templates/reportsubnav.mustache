{{!
    @template mod_giportfolio/reportsubnav

    Bootstrap pills sub-navigation for the Reports tab.

    Example context (json):
    {
        "tabs": [
            {"url": "/mod/giportfolio/submissions.php?id=1&tab=reports", "label": "General report", "active": true},
            {"url": "/mod/giportfolio/submissions.php?id=1&tab=reports&subreport=contributions", "label": "Contribution report", "active": false}
        ]
    }
}}
<div class="giportfolio-subnav bg-light border rounded px-3 py-2 mb-4 d-flex align-items-center gap-2" role="tablist">
    {{#tabs}}
    <a class="giportfolio-subnav-tab{{#active}} active{{/active}}" href="{{url}}" role="tab" title="{{title}}">{{label}}</a>
    {{/tabs}}
</div>
